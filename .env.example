TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Опционально: прокси (socks5, socks4, http)
# TELEGRAM_PROXY_SCHEME=socks5
# TELEGRAM_PROXY_HOSTNAME=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USERNAME=user
# TELEGRAM_PROXY_PASSWORD=pass

# Опционально: Jev-вердикты для clean_my_subs.py (ключ с console.typesafe.ai
# или OpenRouter). Без ключа кандидаты показываются с одними метриками.
# Через OpenRouter:
# TYPESAFE_API_KEY=sk-or-...
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# Через TypeSafe напрямую (base_url можно не указывать):
# TYPESAFE_API_KEY=ts-...
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Модель (по умолчанию jev-latest):
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Файл категорий для sort_chats.py, одна категория на строку.
# Нет переменной — categories.txt рядом со скриптом.
# CATEGORIES_FILE=categories.txt

